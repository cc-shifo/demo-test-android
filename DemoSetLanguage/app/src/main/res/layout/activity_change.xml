<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">

        <com.example.demosetlanguage.widget.AppTextView
            android:text="@string/current_lng_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.example.demosetlanguage.widget.AppTextView
            android:text="@string/curr_Language"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />



    </LinearLayout>

    <com.example.demosetlanguage.widget.AppButton
        android:id="@+id/btn_english"
        android:text="@string/lng_english"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.example.demosetlanguage.widget.AppButton
        android:id="@+id/btn_chinese"
        android:text="@string/lng_chinese"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />


    <com.example.demosetlanguage.widget.AppTextView
        android:id="@+id/set_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="@string/set_text"
        />
    <com.example.demosetlanguage.widget.AppTextView
        android:id="@+id/set_text_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="@string/set_text"
        />

    <com.example.demosetlanguage.widget.AppTextView
        android:id="@+id/global_set_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="@string/global_text"
        />
    <com.example.demosetlanguage.widget.AppTextView
        android:id="@+id/global_set_txt_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="@string/global_text"
        />
</LinearLayout>